# /etc/englishlearn/env
# 权限：chmod 600，属主 root
DB_PASSWORD=换成你的数据库密码
DB_USERNAME=englishlearn
DB_URL=jdbc:mysql://127.0.0.1:3306/englishlearn?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=Asia/Shanghai
LOG_FILE=/opt/englishlearn/logs/server.log

# 后台管理员：B 站 mid，逗号分隔；为空时没人能进后台
ADMIN_MIDS=8343799
# 会话有效期（天）
AUTH_SESSION_DAYS=30
# 线上走 https 时设为 true
AUTH_COOKIE_SECURE=true
